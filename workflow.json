        "responses": {
          "values": [
            {
              "content": "=You are a job market analyst specializing in data roles.\nTitle: {{ $json.title }}\nRequired skills: {{ $json.requiredSkills }}\nExperience level: {{ $json.experienceLevel }}\n\nTasks:\n1. Extract and normalize key skills to English (e.g. \"Excel\", \"SQL\", \"Python\"). If no skills provided, infer from the job title.\n2. Classify into ONE category based on title AND skills:\n   - data analyst (SQL, Excel, reporting, dashboards, BI tools)\n   - data scientist (Python, ML, statistics, modeling, research)\n   - business intelligence (Power BI, Tableau, Qlik, data warehousing)\n   - machine learning / ai (AI, deep learning, LLM, NLP, computer vision)\n   - data engineer (pipelines, ETL, Spark, Kafka, cloud data)\n   - data governance / quality (data quality, MDM, compliance)\n   - data architect (architecture, modeling, data strategy)\n   - irrelevant (not a data role - physical work, sales, unrelated field)\n   - other (data role but doesn't fit above categories)\n\nReturn ONLY valid JSON:\n{\n  \"skills\": [\"skill1\", \"skill2\"],\n  \"category\": \"one of the categories above\"\n}"
            }
          ]
        },
        "builtInTools": {},
        "options": {}
      },
