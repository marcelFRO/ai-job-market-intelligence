    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const apifyData = $input.item.json;\nconst gptText = apifyData.output[0].content[0].text;\nconst cleaned = gptText.replace(/```json\\n?/g, '').replace(/```\\n?/g, '').trim();\nconst gpt = JSON.parse(cleaned);\n\n// Pomiń irrelevant\nif (gpt.category === \"irrelevant\") {\n  return null;\n}\n\n// Wyciągnij salary - preferuj PLN\nconst employment = apifyData.employmentTypes?.find(e => e.currency === \"pln\") \n  || apifyData.employmentTypes?.[0] \n  || {};\n\nreturn { json: {\n  // Z GPT\n  skills: gpt.skills?.join(\", \") || \"\",\n  category: gpt.category || \"\",\n  \n  // Bezpośrednio z Apify\n  title: apifyData.title || \"\",\n  city: apifyData.city || \"\",\n  company: apifyData.companyName || \"\",\n  experience_level: apifyData.experienceLevel || \"\",\n  workplace_type: apifyData.workplaceType || \"\",\n  salary_from: employment.fromPln || \"\",\n  salary_to: employment.toPln || \"\",\n  salary_currency: employment.currency || \"\",\n  employment_type: employment.type || \"\",\n  published_at: apifyData.publishedAt || \"\",\n  link: apifyData.link || \"\",\n  source: \"justjoin.it\",\n  timestamp: new Date().toISOString()\n}};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1200, 144],
      "id": "9db05503-62db-492c-a857-2722b32740ce",
